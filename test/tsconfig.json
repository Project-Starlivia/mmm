{
  // テストは Node で動く（DOM はグローバルに無く、要る試験が happy-dom で
  // 自分の窓を立てる）。src の型だけ借りる。
  // "dom" lib は型定義だけの話で実行時の DOM の有無とは関係ない —
  // src/app.ts 等 DOM 依存のファイルから純粋な関数だけを import
  // するときに、そのファイルの他の部分の型チェックが通るように要る。
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable", "DOM.AsyncIterable"],
    "types": ["node"],
    "allowImportingTsExtensions": true
  },
  "include": [".", "../src/app.ts"]
}
