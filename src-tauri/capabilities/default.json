{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "mmm の窓に許す操作。ファイル I/O は自前コマンド経由なので、ここではコアと dialog だけ。",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "dialog:default",
    "dialog:allow-ask",
    "opener:allow-open-url",
    "opener:allow-default-urls"
  ]
}
