{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mmm",
  "version": "0.1.0",
  "identifier": "com.atrium.mmm",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:13131",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "mmm",
        "width": 1100,
        "height": 720,
        "minWidth": 480,
        "minHeight": 360,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
