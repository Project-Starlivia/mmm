{
  "name": "mmm",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "core": "cd core && moon build --target js --release",
    "dev": "pnpm run core && vite",
    "build": "pnpm run core && tsc --noEmit && vite build",
    "preview": "vite preview",
    "lab": "pnpm run core && vite lab --port 13132 --strictPort",
    "test": "pnpm run core && node --test \"test/*.test.ts\"",
    "test:core": "cd core && moon test -p mmm-app/core/tree -p mmm-app/core/view -p mmm-app/core/op",
    "check": "tsc --noEmit && tsc -p test --noEmit && tsc -p lab --noEmit",
    "check:core": "cd core && moon check && moon fmt --check tree view op",
    "fixtures": "node test/tools/gen-load.ts",
    "deploy": "pnpm run build && wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run"
  },
  "devDependencies": {
    "@lezer/markdown": "^1.7.2",
    "@types/node": "^26.2.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "wrangler": "^4.126.0"
  },
  "dependencies": {
    "@codemirror/commands": "^6.7.0",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/language": "^6.10.0",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.5.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.35.0",
    "@lezer/highlight": "^1.2.3"
  }
}
